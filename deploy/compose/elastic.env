# ==== Elasticsearch Vector DB — NVIDIA-Hosted Models ====
# Use this instead of nvdev.env when running Elasticsearch as the vector store.
# Pulls in all NVIDIA API Catalog model/endpoint settings from nvdev.env,
# then overrides the vector DB settings for Elasticsearch.
#
# Usage:
#   source deploy/compose/elastic.env
#
# Then start services:
#   docker compose -f deploy/compose/vectordb.yaml --profile elasticsearch up -d
#   docker compose -f deploy/compose/docker-compose-ingestor-server.yaml up -d
#   docker compose -f deploy/compose/docker-compose-rag-server.yaml up -d
#
# Note: You must re-upload documents after switching from Milvus — data does not migrate.

# Load all NVIDIA API Catalog model/endpoint settings
source "$(dirname "${BASH_SOURCE[0]}")/nvdev.env"

# ==== Vector DB: Elasticsearch ====
export APP_VECTORSTORE_NAME="elasticsearch"
export APP_VECTORSTORE_URL="http://elasticsearch:9200"

# Authentication (leave empty if security is disabled, which is the default)
export APP_VECTORSTORE_USERNAME=""
export APP_VECTORSTORE_PASSWORD=""
# API key auth (alternative to username/password — set one or the other, not both)
# export APP_VECTORSTORE_APIKEY=""
# export APP_VECTORSTORE_APIKEY_ID=""
# export APP_VECTORSTORE_APIKEY_SECRET=""

# ==== Elasticsearch Container Setup (one-time) ====
# Before first run, create the data directory and set permissions:
#   mkdir -p deploy/compose/volumes/elasticsearch
#   sudo chown -R 1000:1000 deploy/compose/volumes/elasticsearch
# If the container fails to start due to permissions:
#   sudo chmod -R 777 deploy/compose/volumes/elasticsearch
